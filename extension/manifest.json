{
  "manifest_version": 3,
  "name": "ApplyStack \u2014 Save & Apply",
  "version": "1.3.0",
  "description": "Save the job posting you're viewing to ApplyStack, and fill in application forms from your profile.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save job to tracker (Alt+Shift+J)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Save this job"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://applystack.app/*",
    "https://www.applystack.app/*",
    "https://*.vercel.app/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://www.linkedin.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "job-tracker@localhost",
      "strict_min_version": "115.0"
    }
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
